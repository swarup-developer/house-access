<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Root of the BepInEx install whose core/interop assemblies we compile against.
         Auto-detected at build time: a real game install (a folder containing
         HouseParty.exe with a BepInEx\core + BepInEx\interop next to it) on any
         fixed drive wins; otherwise the copy stashed in the repo's tmp folder is
         used so the project still builds out of the box. Force a specific root
         with: dotnet build -p:BepInExRoot=C:\path\to\BepInEx -->
    <BepInExRootDefault>$(MSBuildProjectDirectory)\..\tmp\BepInEx788-aside</BepInExRootDefault>
    <BepInExRootExplicit Condition="'$(BepInExRoot)' != ''">true</BepInExRootExplicit>
    <BepInExRootExplicit Condition="'$(BepInExRootExplicit)' == ''">false</BepInExRootExplicit>
    <BepInExRoot Condition="'$(BepInExRoot)' == ''">$(BepInExRootDefault)</BepInExRoot>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HouseAccess</AssemblyName>
    <RootNamespace>HouseAccess</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExRoot)\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
