<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Root of the BepInEx install whose core/interop assemblies we compile against.
         Auto-detected at build time: a real game install (a folder containing
         HouseParty.exe with a BepInEx\core + BepInEx\interop next to it) on any
         fixed drive is used. Do not fall back to a stale interop snapshot.
         Force a specific root
         with: dotnet build -p:BepInExRoot=C:\path\to\BepInEx -->
    <BepInExRootDefault>$(MSBuildProjectDirectory)\..\BepInEx</BepInExRootDefault>
    <BepInExRootExplicit Condition="'$(BepInExRoot)' != ''">true</BepInExRootExplicit>
    <BepInExRootExplicit Condition="'$(BepInExRootExplicit)' == ''">false</BepInExRootExplicit>
    <BepInExRoot Condition="'$(BepInExRoot)' == ''">$(BepInExRootDefault)</BepInExRoot>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HouseAccess</AssemblyName>
    <RootNamespace>HouseAccess</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <!-- Locate the BepInEx install before creating assembly references.
       Uses an MSBuild inline task
       so detection runs on any machine with a .NET SDK. -->
  <UsingTask TaskName="FindBepInExRoot" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <BepInExRoot ParameterType="System.String" Required="true" />
      <DefaultRoot ParameterType="System.String" Required="true" />
      <ExplicitRoot ParameterType="System.Boolean" Required="true" />
      <FoundRoot ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        var final = BepInExRoot;
        if (!ExplicitRoot)
        {
            // Depth-limited walk of each fixed drive. A folder that contains
            // HouseParty.exe with a BepInEx\core + BepInEx\interop next to it is
            // a candidate. System and user folders are skipped to keep the walk fast.
            var primary = new List<string>();

            void Walk(string start, int depth)
            {
                if (depth > 4) return;
                List<string> dirs;
                try { dirs = Directory.EnumerateDirectories(start, "*", SearchOption.TopDirectoryOnly).ToList(); }
                catch { return; }
                foreach (var d in dirs)
                {
                    var name = Path.GetFileName(d);
                    if (name.StartsWith("$") || name.StartsWith(".")) continue;
                    if (depth == 0 && (name == "Windows" || name == "ProgramData" || name == "Users"
                        || name == "System Volume Information" || name == "Recovery" || name == "PerfLogs")) continue;
                    try
                    {
                        var be = Path.Combine(d, "BepInEx");
                        if (Directory.Exists(Path.Combine(be, "core")) && Directory.Exists(Path.Combine(be, "interop")))
                        {
                            if (File.Exists(Path.Combine(d, "HouseParty.exe"))
                                && File.Exists(Path.Combine(be, "interop", "EekCharacterEngine.dll"))
                                && File.Exists(Path.Combine(be, "interop", "EekUI.dll"))) primary.Add(be);
                        }
                    }
                    catch { }
                    Walk(d, depth + 1);
                }
            }

            var steamGame = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.ProgramFilesX86),
                "Steam", "steamapps", "common", "House Party");
            var steamBepInEx = Path.Combine(steamGame, "BepInEx");
            if (File.Exists(Path.Combine(steamGame, "HouseParty.exe"))
                && File.Exists(Path.Combine(steamBepInEx, "core", "BepInEx.Core.dll"))
                && File.Exists(Path.Combine(steamBepInEx, "interop", "EekCharacterEngine.dll"))
                && File.Exists(Path.Combine(steamBepInEx, "interop", "EekUI.dll")))
                primary.Add(steamBepInEx);

            if (primary.Count == 0)
            {
                foreach (var drive in DriveInfo.GetDrives())
                {
                    if (!drive.IsReady || drive.DriveType != DriveType.Fixed) continue;
                    try { Walk(drive.RootDirectory.FullName, 0); }
                    catch { }
                }
            }

            final = primary.Count > 0 ? primary[0] : DefaultRoot;

        }
        FoundRoot = final;
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="ResolveBepInExRoot" BeforeTargets="ResolveAssemblyReferences">
    <FindBepInExRoot BepInExRoot="$(BepInExRoot)" DefaultRoot="$(BepInExRootDefault)" ExplicitRoot="$(BepInExRootExplicit)">
      <Output TaskParameter="FoundRoot" PropertyName="BepInExRoot" />
    </FindBepInExRoot>
    <Message Importance="high" Text="Compiling against BepInEx at: $(BepInExRoot)" />
    <Error Condition="!Exists('$(BepInExRoot)\core\BepInEx.Core.dll')" Text="Could not locate a BepInEx install (BepInEx\core\BepInEx.Core.dll not found at $(BepInExRoot)). Install BepInEx next to HouseParty.exe, or pass -p:BepInExRoot=&quot;C:\path\to\BepInEx&quot;." />
    <Error Condition="!Exists('$(BepInExRoot)\interop\EekCharacterEngine.dll') Or !Exists('$(BepInExRoot)\interop\EekUI.dll') Or !Exists('$(BepInExRoot)\interop\EekEvents.dll') Or !Exists('$(BepInExRoot)\interop\HouseParty.dll')" Text="This version targets House Party's split game assemblies. Point BepInExRoot at the current game's generated interop directory's parent, not an older single-assembly snapshot." />
    <!-- Add references only after detection, including the split game assemblies
         absent from the old hardcoded Assembly-CSharp reference list. -->
    <ItemGroup>
      <Reference Include="$(BepInExRoot)\core\BepInEx.Core.dll;$(BepInExRoot)\core\BepInEx.Unity.IL2CPP.dll;$(BepInExRoot)\core\0Harmony.dll;$(BepInExRoot)\core\Il2CppInterop.Runtime.dll">
        <Private>false</Private>
      </Reference>
      <Reference Include="$(BepInExRoot)\interop\*.dll">
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>

</Project>
